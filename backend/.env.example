# Server
PORT=8000

# OpenRouter (key provided via InsForge — keep server-only, never commit)
OPENROUTER_API_KEY=
# Optional: defaults to anthropic/claude-sonnet-4.5
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Kubernetes: path to a kubeconfig file (optional; defaults to kubectl's normal config)
KUBECONFIG_PATH=

# Local mode: register this machine's kubeconfig contexts as clusters owned by
# this InsForge user id (the dev loop, and the single-operator demo box).
# Leave empty in a real multi-tenant deployment -- other users enrol their own
# clusters instead of seeing the server's kubeconfig.
LOCAL_CLUSTER_OWNER=

# InsForge (server-only admin credentials — never expose to the frontend)
# URL: `oss_host` in .insforge/project.json; API key: `api_key` in the same file
INSFORGE_URL=
INSFORGE_API_KEY=
